# ============================================================
# AgentGit Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your API key.
#
# Supports OpenAI, OpenRouter, or any OpenAI-compatible API.
# ============================================================

# Your API key (required)
OPENAI_API_KEY=your_api_key_here

# Base URL for the API (set this for OpenRouter or other providers)
# OpenRouter: https://openrouter.ai/api/v1
# OpenAI (default): https://api.openai.com/v1
OPENAI_API_BASE=https://openrouter.ai/api/v1

# Model used for the 4 workflow stages (plan/research/draft/review)
MODEL_NAME=gpt-4o-mini

# Model used for the LLM-as-judge scoring
JUDGE_MODEL_NAME=gpt-4o-mini
